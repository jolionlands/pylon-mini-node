{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jolionlands/pylon/protocol/node/v3/prewarm.response.schema.json",
  "title": "POST {node_root}/prewarm response (node -> pylon)",
  "description": "ok is always true for a handled request; prefill_issued says whether the engine was asked to prefill.",
  "type": "object",
  "required": [
    "ok",
    "prefill_issued"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "prefill_issued": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "examples": [
    {
      "ok": true,
      "prefill_issued": true
    },
    {
      "ok": true,
      "prefill_issued": false,
      "reason": "circuit open"
    }
  ]
}
