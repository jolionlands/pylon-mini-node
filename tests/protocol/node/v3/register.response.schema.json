{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jolionlands/pylon/protocol/node/v3/register.response.schema.json",
  "title": "POST /v1/nodes/register response",
  "description": "node_token is shown once; the node presents it as a Bearer token on every later call.",
  "type": "object",
  "required": [
    "node",
    "node_token"
  ],
  "properties": {
    "node": {
      "$ref": "common.schema.json#/$defs/node"
    },
    "node_token": {
      "type": "string",
      "minLength": 1
    },
    "warning": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "examples": [
    {
      "node": {
        "id": "n_1",
        "name": "maverick-forge",
        "pool": "long",
        "state": "ready",
        "protocol_version": "3"
      },
      "node_token": "example-node-token",
      "warning": "store this node_token now -- it is shown only once"
    }
  ]
}
